# Supabase — Project Settings → API
# Both values are safe for the browser (the anon key is protected by RLS).
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-anon-public-key

# ── Soliq integrations (server-side only; set in Railway, NOT VITE_) ──────────
# Missing values ⇒ that provider stays in demo mode.
# DIDOX — partner token from @Didox_account (mandatory for DIDOX API).
DIDOX_PARTNER_TOKEN=
DIDOX_BASE_URL=https://testapi3.didox.uz
# Faktura.uz — OAuth token endpoint (per-user login/password sent from the app).
FAKTURA_BASE_URL=https://api.faktura.uz/Api
FAKTURA_TOKEN_URL=https://account.faktura.uz/token
# SOLIQ Servis — commercial API token.
SOLIQSERVIS_BASE_URL=https://api.soliq-servis.uz
SOLIQSERVIS_TOKEN=
